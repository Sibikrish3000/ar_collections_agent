# Example environment configuration for ar-collections-agent.
# Copy to .env and fill in values. The default run (no LLM flags) needs nothing.
#
# All values are optional. The agent runs fully deterministically without them.

# --- LLM endpoint (optional, for --llm and --llm-drafts flags) ---

# Base URL for an OpenAI-compatible endpoint. Defaults to the official API.
# Examples: https://my-gateway.example/v1, http://localhost:11434/v1
LLM_BASE_URL=http://localhost:20128/v1

# API key for the endpoint. Some local endpoints (Ollama, LM Studio) ignore this.
# The official OpenAI API requires it.
# LLM_API_KEY=sk-...

# Model name to send to the endpoint.
# Defaults to gpt-4o-mini for the official API.
LLM_MODEL=antigravity

# Request timeout in seconds. Defaults to 30.
# LLM_TIMEOUT_SECONDS=30

# --- OpenAI-specific (fallbacks if LLM_* are not set) ---
# These are honoured for compatibility with environments already set up for the official API.
# LLM_* takes precedence if both are set.

# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Notes ---
#
# - Default run: `ar-collections-agent` — fully deterministic, no model needed, no env vars required.
# - With --llm: classifications are cached to data/reply_classifications.json, so a replay
#   run on a different machine without a key reproduces the exact same behavior.
# - With --llm-drafts: rewrites draft email bodies, re-verifies every figure, and falls back
#   to the deterministic draft if the model fails or changes any amount/invoice/date.
# - A timeout, connection failure, or unusable response degrades to the rule engine,
#   never crashes the run.
